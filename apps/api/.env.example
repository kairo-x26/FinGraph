# Copy to .env for local development. Every value has a working default.
# DATABASE_URL=pglite://./.data/pg           # or postgres://fingraph:fingraph@localhost:5432/fingraph
# STORAGE_LOCAL_DIR=./.data/objects
# PUBLIC_API_URL=http://localhost:3000/api   # the API as seen by browsers (through the web proxy)
# WEB_URL=http://localhost:3000
# OIDC_ISSUER=http://localhost:4100          # the sandbox IdP
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# OCR_PROVIDER=tesseract
